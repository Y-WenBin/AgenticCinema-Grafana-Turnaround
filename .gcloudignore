# What `gcloud run deploy --source .` / `gcloud builds submit` must NOT upload.
# Secrets first — these never leave the machine.
.env
.env.*
!.env.example
.secrets/
.secrets/**

.git/
.github/
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
agent/_writeback.jsonl

# The design canvas working files: local tooling for the interface, not
# something the running service needs. Keeps 2.5MB of artboards out of
# the build context and the image.
.design/
