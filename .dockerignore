# build context hygiene — keep secrets and local cruft out of the image
.git
.github
.venv
.pytest_cache
.ruff_cache
__pycache__
**/__pycache__
*.pyc
.env
.env.*
!.env.example
.secrets
deploy/*.md
tests
*.md
!README.md
# web/ ships: it is the playground the deployed service serves at `/`.
agent/_writeback.jsonl

# The design canvas working files: local tooling for the interface, not
# something the running service needs. Keeps 2.5MB of artboards out of
# the build context and the image.
.design/
