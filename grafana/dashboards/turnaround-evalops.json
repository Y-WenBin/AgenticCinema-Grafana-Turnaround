{
  "uid": "turnaround-evalops",
  "title": "Turnaround \u00b7 EvalOps",
  "description": "The agent's own token economics, latency and continuous evaluation score -- gen_ai.* telemetry from observability/ and agent/evaluation.py.",
  "tags": [
    "turnaround",
    "evalops",
    "genai"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": [
      {
        "name": "Director notes",
        "enable": true,
        "iconColor": "yellow",
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "director-note"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**The agent, watched the way it reasons.** Token economics and operation latency from the OpenTelemetry GenAI conventions (`observability/`), and a continuous evaluation score from the judge tier (`agent/evaluation.py`) -- a deterministic ground-truth + privacy check and an independent Gemini judge. Every `gen_ai.evaluation.result` carries the run's `response_id`; the same id is on every `chat` and `execute_tool` span, so a low score pivots straight to the trace, the prompt and the PromQL behind it."
      }
    },
    {
      "type": "stat",
      "title": "Evaluations (last 1h)",
      "description": "Judge activity. Zero means no runs, or the judge tier is off.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"turnaround-agent\"} | json [1h]))",
          "legendFormat": "events",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Mean grounding score (1h)",
      "description": "LLM judge: is every number in the answer backed by a tool call? The EVAL_DRIFT alert trips below 0.8.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"hallucination\" | unwrap score [1h])",
          "legendFormat": "grounding",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Task completion (1h)",
      "description": "LLM judge: does the answer resolve the ask, not just describe it?",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"task_completion\" | unwrap score [1h])",
          "legendFormat": "task",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Privacy-floor failures (1h)",
      "description": "A sub-floor pool (di-pool-1) named in an answer or its evidence. Must be zero. Any non-zero value pages.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"turnaround-agent\"} | json | name=\"privacy_floor_respected\" | label=\"fail\" [1h]))",
          "legendFormat": "breaches",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Evaluation score by dimension",
      "description": "Quality drift over time. A dimension trending down is the signal the proposal calls for -- pivot to the failing run below.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"grounding_numbers\" | unwrap score [$__interval])",
          "legendFormat": "grounding_numbers",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"mechanism_named\" | unwrap score [$__interval])",
          "legendFormat": "mechanism_named",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"privacy_floor_respected\" | unwrap score [$__interval])",
          "legendFormat": "privacy_floor_respected",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"relevance\" | unwrap score [$__interval])",
          "legendFormat": "relevance",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"hallucination\" | unwrap score [$__interval])",
          "legendFormat": "hallucination",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"task_completion\" | unwrap score [$__interval])",
          "legendFormat": "task_completion",
          "queryType": "range",
          "range": true,
          "instant": false,
          "refId": "F"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token usage by model and type (cumulative)",
      "description": "gen_ai.client.token.usage. Group by team/feature/model to build a token-budget panel; here it is model x {input,output}.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (gen_ai_client_token_usage_sum)",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Operation duration p95 (chat vs tool, over the window)",
      "description": "gen_ai.client.operation.duration. increase() over the dashboard range, not rate() -- runs are bursty, so a short rate window is usually empty between them.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_operation_name) (increase(gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=~\"chat|execute_tool\"}[$__range])))",
          "legendFormat": "{{gen_ai_operation_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Evaluation events (newest first)",
      "description": "Every gen_ai.evaluation.result. The response_id links to the run's trace in Tempo -- pivot a low score to the exact chat and PromQL behind it.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "expr": "{service_name=\"turnaround-agent\"}",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true,
              "Time": false
            },
            "indexByName": {
              "Time": 0,
              "name": 1,
              "label": 2,
              "score": 3,
              "actor_type": 4,
              "response_id": 5,
              "explanation": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "response_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the run's trace in Tempo",
                    "url": "/explore?left=%7B%22datasource%22%3A%20%22grafanacloud-traces%22%2C%20%22queries%22%3A%20%5B%7B%22refId%22%3A%20%22A%22%2C%20%22queryType%22%3A%20%22traceql%22%2C%20%22query%22%3A%20%22%7B%20span.gen_ai.response.id%20%3D%20%5C%22%24%7B__value.raw%7D%5C%22%20%7D%22%7D%5D%2C%20%22range%22%3A%20%7B%22from%22%3A%20%22now-6h%22%2C%20%22to%22%3A%20%22now%22%7D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "label"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fail": {
                        "color": "red",
                        "index": 0
                      },
                      "pass": {
                        "color": "green",
                        "index": 1
                      },
                      "borderline": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Tool calls by tool (cumulative)",
      "description": "Which Grafana MCP tools the agent leans on. A spike in one tool is often an agent looping.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_tool_name) (gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"execute_tool\"})",
          "legendFormat": "{{gen_ai_tool_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Chat calls by agent (cumulative)",
      "description": "LLM calls per agent in the pipeline. The synthesis step and a looping analyst both show up here.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (gen_ai_agent_name) (gen_ai_client_token_usage_count{gen_ai_token_type=\"input\"})",
          "legendFormat": "{{gen_ai_agent_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    }
  ]
}
