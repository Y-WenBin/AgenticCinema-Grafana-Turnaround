{
  "uid": "turnaround-join",
  "title": "Turnaround \u00b7 The Join",
  "description": "Render effort per creative iteration, and the render waste it hides, keyed on sequence.",
  "tags": [
    "turnaround",
    "join",
    "render"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": [
      {
        "name": "Director notes",
        "enable": true,
        "iconColor": "yellow",
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "director-note"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "sequence",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(turnaround_task_iterations_total, sequence)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**The creative plane joined to the compute plane on `sequence`.** OpenCue core-hours over Kitsu iterations \u2014 a number no scheduling tool and no farm dashboard can produce alone. SEQ0420 runs about 4\u00d7 every other sequence, and has since before the note."
      }
    },
    {
      "type": "timeseries",
      "title": "Render core-hours per comp iteration, by sequence",
      "description": "Cumulative farm core-hours over cumulative comp passes. SEQ0420 sits well clear of every other sequence.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (sequence) (turnaround_render_core_hours_total{department=\"comp\"}) / sum by (sequence) (turnaround_task_iterations_total{department=\"comp\"})",
          "legendFormat": "{{sequence}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Wasted render core-hours by sequence",
      "description": "Farm time that produced no accepted frame, attributed to the shot that caused it.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (sequence) (turnaround_render_waste_core_hours_total)",
          "legendFormat": "{{sequence}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frame-failure rate by sequence",
      "description": "A healthy farm loses ~2% of frames. Frame 118 of every SEQ0420 comp render is the regression.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (sequence) (turnaround_render_frames_failed_total) / clamp_min(sum by (sequence) (turnaround_render_frames_total), 1)",
          "legendFormat": "{{sequence}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    }
  ]
}
