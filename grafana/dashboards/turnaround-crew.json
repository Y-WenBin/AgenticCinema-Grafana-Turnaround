{
  "uid": "turnaround-crew",
  "title": "Turnaround \u00b7 Crew Load",
  "description": "Weekly hours per rostered artist, per pool, with the aggregation floor visible.",
  "tags": [
    "turnaround",
    "crew",
    "hero"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": [
      {
        "name": "Director notes",
        "enable": true,
        "iconColor": "yellow",
        "datasource": {
          "type": "prometheus",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "director-note"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "sequence",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(turnaround_task_iterations_total, sequence)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Hours per rostered artist per week, by pool.** The forecastable half of crunch.\n\nEvery panel on this board except the last one carries the aggregation floor *in its query* \u2014 `and on(pool) (max by (pool) (turnaround_pool_headcount) >= 3)` \u2014 so a pool of fewer than three people cannot appear in an aggregate here even by accident. `di-pool-1` is two people; it shows only in the panel at the bottom, which is labelled internal-only for exactly that reason."
      }
    },
    {
      "type": "stat",
      "title": "comp-pool-2 \u2014 hours per rostered artist",
      "description": "The pool the show is about. Sustained >60 h/week is crunch. Grafana ML job turnaround-comp-pool-2-hours forecasts this series.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max(turnaround_artist_hours_logged{pool=\"comp-pool-2\"})",
          "legendFormat": "comp-pool-2",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Weekly hours by pool (pools of 3+)",
      "description": "A 40 h line is the plan; 60 h is unsustainable by the studio's own account.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (pool) (turnaround_artist_hours_logged) and on(pool) (max by (pool) (turnaround_pool_headcount) >= 3)",
          "legendFormat": "{{pool}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Pools over 55 h that an alert can fire on",
      "description": "The floor join in action. di-pool-1 cannot appear here even when its two people are buried.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "(max by (pool, department) (turnaround_artist_hours_logged > 55)) and on(pool) (turnaround_pool_headcount >= 3)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Rostered headcount (pools of 3+)",
      "description": "Join key for the floor. Not a load signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (pool) (turnaround_pool_headcount) and on(pool) (max by (pool) (turnaround_pool_headcount) >= 3)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Below the aggregation floor \u2014 internal only, never share this panel",
      "description": "The pools too small to aggregate safely. Kept for roster context inside the studio, where the viewer is already authenticated and already knows who is on the show. Everything above this panel is floor-safe by query, so the rest of this board could be shared; this panel is why it is not. The agent is forbidden from naming these pools (bridge/privacy.py), and the public control room at /api/backend cannot reach them.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (pool) (turnaround_pool_headcount) < 3",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ]
    }
  ]
}
