[
  {
    "title": "turnaround",
    "folderUid": "turnaround",
    "interval": 60,
    "rules": [
      {
        "uid": "turnaround-crew-crunch",
        "title": "Comp pool heading past 60 h/week",
        "condition": "C",
        "for": "0s",
        "folderUID": "turnaround",
        "ruleGroup": "turnaround",
        "noDataState": "OK",
        "execErrState": "Error",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 10800,
              "to": 0
            },
            "datasourceUid": "grafanacloud-prom",
            "model": {
              "refId": "A",
              "expr": "last_over_time(((max by (pool) (turnaround_artist_hours_logged{department=\"comp\"})) and on(pool) (turnaround_pool_headcount >= 3))[3h:1m])",
              "instant": true,
              "range": false,
              "editorMode": "code",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "datasource": {
                "type": "prometheus",
                "uid": "grafanacloud-prom"
              }
            }
          },
          {
            "refId": "C",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "type": "threshold",
              "expression": "A",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "conditions": [
                {
                  "type": "query",
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      60
                    ]
                  }
                }
              ]
            }
          }
        ],
        "labels": {
          "severity": "warning",
          "team": "production",
          "signal": "crew-load"
        },
        "annotations": {
          "summary": "{{ $labels.pool }} is at {{ printf \"%.0f\" $values.A.Value }} h per rostered artist this week.",
          "lever": "The cause is upstream: every comp iteration on SEQ0420 is burning ~4x the farm core-hours it should, because frame 118 keeps failing. Fix the lighting cache regression and the rework that is filling this pool's week stops being necessary."
        }
      },
      {
        "uid": "turnaround-render-waste",
        "title": "A sequence is concentrating render waste",
        "condition": "C",
        "for": "0s",
        "folderUID": "turnaround",
        "ruleGroup": "turnaround",
        "noDataState": "OK",
        "execErrState": "Error",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 10800,
              "to": 0
            },
            "datasourceUid": "grafanacloud-prom",
            "model": {
              "refId": "A",
              "expr": "last_over_time((sum by (sequence) (turnaround_render_waste_core_hours_total))[3h:1m])",
              "instant": true,
              "range": false,
              "editorMode": "code",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "datasource": {
                "type": "prometheus",
                "uid": "grafanacloud-prom"
              }
            }
          },
          {
            "refId": "C",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "type": "threshold",
              "expression": "A",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "conditions": [
                {
                  "type": "query",
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      20
                    ]
                  }
                }
              ]
            }
          }
        ],
        "labels": {
          "severity": "warning",
          "team": "pipeline",
          "signal": "render-waste"
        },
        "annotations": {
          "summary": "{{ $labels.sequence }} has wasted {{ printf \"%.0f\" $values.A.Value }} farm core-hours on renders that produced no accepted frame.",
          "lever": "Pull the failing frames for this sequence from Loki (`{service_name=\"turnaround-bridge\"} |= \"frame 118\"`), identify the cache key, and invalidate it. This waste predates the director note."
        }
      }
    ]
  },
  {
    "title": "turnaround-evalops",
    "folderUid": "turnaround",
    "interval": 60,
    "rules": [
      {
        "uid": "turnaround-eval-grounding-drift",
        "title": "Agent answers are drifting off their evidence",
        "condition": "C",
        "for": "0s",
        "folderUID": "turnaround",
        "ruleGroup": "turnaround-evalops",
        "noDataState": "OK",
        "execErrState": "Error",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 3600,
              "to": 0
            },
            "datasourceUid": "grafanacloud-logs",
            "model": {
              "refId": "A",
              "expr": "avg_over_time({service_name=\"turnaround-agent\"} | json | name=\"hallucination\" | unwrap score [1h])",
              "queryType": "range",
              "editorMode": "code",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "datasource": {
                "type": "loki",
                "uid": "grafanacloud-logs"
              }
            }
          },
          {
            "refId": "B",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "B",
              "type": "reduce",
              "expression": "A",
              "reducer": "last",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "settings": {
                "mode": "dropNN"
              }
            }
          },
          {
            "refId": "C",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "type": "threshold",
              "expression": "B",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "conditions": [
                {
                  "type": "query",
                  "evaluator": {
                    "type": "lt",
                    "params": [
                      0.8
                    ]
                  }
                }
              ]
            }
          }
        ],
        "labels": {
          "severity": "warning",
          "team": "ai-eng",
          "signal": "eval-drift"
        },
        "annotations": {
          "summary": "Mean grounding score over the last hour is {{ printf \"%.2f\" $values.B.Value }} (< 0.80): the agent is asserting numbers the tool timeline does not support.",
          "lever": "Open Turnaround \u00b7 EvalOps, sort the events table by score, and follow the response_id link to the run's trace. The failing claim is in the synthesis step's chat span; tighten the analyst prompt that fed it or the recipe it used."
        }
      },
      {
        "uid": "turnaround-eval-privacy-breach",
        "title": "A sub-floor pool was named in an answer",
        "condition": "C",
        "for": "0s",
        "folderUID": "turnaround",
        "ruleGroup": "turnaround-evalops",
        "noDataState": "OK",
        "execErrState": "Error",
        "data": [
          {
            "refId": "A",
            "relativeTimeRange": {
              "from": 3600,
              "to": 0
            },
            "datasourceUid": "grafanacloud-logs",
            "model": {
              "refId": "A",
              "expr": "sum(count_over_time({service_name=\"turnaround-agent\"} | json | name=\"privacy_floor_respected\" | label=\"fail\" [1h]))",
              "queryType": "range",
              "editorMode": "code",
              "intervalMs": 1000,
              "maxDataPoints": 43200,
              "datasource": {
                "type": "loki",
                "uid": "grafanacloud-logs"
              }
            }
          },
          {
            "refId": "B",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "B",
              "type": "reduce",
              "expression": "A",
              "reducer": "last",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "settings": {
                "mode": "dropNN"
              }
            }
          },
          {
            "refId": "C",
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "type": "threshold",
              "expression": "B",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "conditions": [
                {
                  "type": "query",
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      0
                    ]
                  }
                }
              ]
            }
          }
        ],
        "labels": {
          "severity": "critical",
          "team": "ai-eng",
          "signal": "privacy-floor"
        },
        "annotations": {
          "summary": "{{ printf \"%.0f\" $values.B.Value }} answer(s) in the last hour named a pool below the aggregation floor of 3. This is the one invariant the product cannot break.",
          "lever": "Stop demoing. Pull the run from Turnaround \u00b7 EvalOps, confirm which pool leaked, and check bridge/privacy.py plus the CrunchGuardian prompt -- the floor join in vocabulary.py should have made this impossible."
        }
      }
    ]
  }
]
