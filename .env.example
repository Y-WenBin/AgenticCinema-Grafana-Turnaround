# --- Grafana Cloud -----------------------------------------------------------
# Take the exact OTLP host from your stack's OpenTelemetry tile; it varies by region.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instanceID:token>

GRAFANA_URL=https://<your-stack>.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_<your-service-account-token>

# Datasource UIDs. These are the Grafana Cloud defaults; confirm yours with
# docs/SETUP.md part 2c and override only if they differ.
GRAFANA_DS_PROM_UID=grafanacloud-prom
GRAFANA_DS_LOKI_UID=grafanacloud-logs
GRAFANA_DS_TEMPO_UID=grafanacloud-traces

# Optional. The ML jobs need Prometheus's *numeric* id, which differs per stack;
# grafana/ml/build.py looks it up from GRAFANA_DS_PROM_UID. Set this only to
# skip the lookup (an offline build, or a stack that hides /api/datasources).
# GRAFANA_DS_PROM_ID=8

# The analysts and the Remediator each get their own `mcp-grafana` subprocess,
# spawned over stdio with no port and no URL -- see agent/mcp_grafana.py. There
# is nothing to configure and nothing to start.

# --- Sources -----------------------------------------------------------------
# Optional: a live Kitsu to write findings back to. Unset means the write-back
# is recorded locally instead (agent/writeback.py) and nothing is sent anywhere.
KITSU_URL=http://localhost/api

# Where that local record goes. Defaults to $XDG_STATE_HOME/turnaround/ (or
# ~/.local/state/turnaround/); set this to keep the audit trail somewhere else.
# TURNAROUND_WRITEBACK_LOG=./writeback.jsonl

# --- Google Cloud ------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<project-id>
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model behaviour ---------------------------------------------------------
# How many tokens Gemini 2.5 may spend thinking, per call, in every agent.
#   0   off (default)   -1  dynamic, Gemini's own default   >0  a ceiling
# This is the biggest lever on how long an answer takes. Measured end to end
# against a live stack: dynamic 75.4s / 60.7s, off 24.5s / 18.5s, with every
# scorecard check passing either way -- this pipeline runs finished PromQL
# recipes and formats the results, so there is nothing for thinking to do.
# Raise it if you give the agents genuinely open-ended work.
TURNAROUND_THINKING_BUDGET=0

# --- Privacy -----------------------------------------------------------------
# Salt for artist pseudonymisation. Rotate per deployment; never commit the real
# one. Generate it rather than typing one -- run this in a shell, not here:
#
#   echo "TURNAROUND_PSEUDONYM_SALT=$(openssl rand -hex 16)" >> .env
#
# (appending wins over the line below; this file is read last-value-first-served)
TURNAROUND_PSEUDONYM_SALT=change-me

# --- Public endpoint guardrails ----------------------------------------------
# Only relevant for a deployed, publicly reachable service. Per *instance*:
# with --max-instances N the real ceiling is N x these. See agent/limits.py.
TURNAROUND_ASKS_PER_HOUR=8      # per visitor
TURNAROUND_ASKS_PER_DAY=200     # everyone together — the actual spend ceiling
TURNAROUND_CONCURRENT_ASKS=2    # simultaneous runs

# Interactive API docs (/docs, /redoc, /openapi.json). On by default -- useful
# for a reviewer poking at a demo, needless attack surface anywhere else.
# TURNAROUND_PUBLIC_DOCS=0
